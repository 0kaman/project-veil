# Veil's contender image.
#
# Deliberately mirrors PinchTab's shape: a container that holds the tool AND its
# Chrome, exposing an MCP server over stdio. Both are then spawned the same way
# (`docker exec -i …`), so wall-clock and memory are measured under equivalent
# conditions rather than one native and one containerised.
FROM node:22-bookworm-slim

# Chromium plus the fonts/libs a headless browser actually needs. Without these
# Chrome starts and then dies on first paint, which reads as a Veil bug.
RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium ca-certificates fonts-liberation \
      libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 \
      libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libasound2 \
      procps tini \
    && rm -rf /var/lib/apt/lists/*

ENV CHROME_PATH=/usr/bin/chromium \
    NODE_ENV=production

WORKDIR /app

# Copy only what the MCP server needs at runtime. The repo is a pnpm workspace,
# so the built dist of every package it imports comes along.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/core/package.json      packages/core/
COPY packages/read/package.json      packages/read/
COPY packages/search/package.json    packages/search/
COPY packages/mcp/package.json       packages/mcp/

RUN corepack enable && pnpm install --prod --frozen-lockfile || pnpm install --prod

COPY packages/core/dist   packages/core/dist
COPY packages/read/dist   packages/read/dist
COPY packages/search/dist packages/search/dist
COPY packages/mcp/dist    packages/mcp/dist

# tini reaps the Chrome process tree; without it a killed session leaves zombies,
# which is exactly the mess that polluted yesterday's memory readings.
ENTRYPOINT ["/usr/bin/tini", "--"]
# Idle by default — the harness attaches with `docker exec -i … node …server.js`.
CMD ["sleep", "infinity"]
