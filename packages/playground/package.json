    "clean": "rm -rf dist",
    "analyse": "tsx src/analyse.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ink": "^6.0.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=22"
  }
}
