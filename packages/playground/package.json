{
  "name": "@veil/playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "veil-playground": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.tsx --format esm --sourcemap",
    "dev": "tsx src/index.tsx",
