# Copy to .env and fill in. .env is gitignored.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest

# Surface Veil's intentionally-swallowed failures into the MCP stderr pane.
VEIL_DEBUG=1

# Optional
# CHROME_PATH=
# VEIL_MAX_NODES=800
# VEIL_NAV_TIMEOUT_MS=45000

# Brave Search API. Free tier = 1 query/sec, 2000/month, extra_snippets NOT available.
BRAVE_API_KEY=
