{
  "name": "project-veil",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "clean": "turbo clean",
    "typecheck": "turbo typecheck",
    "test:integration": "pnpm --filter @veil/core test:integration",
    "check": "turbo typecheck build test",
    "play": "pnpm --filter @veil/playground dev",
    "play:analyse": "pnpm --filter @veil/playground analyse",
    "bench:replay": "pnpm --filter @veil/core bench:replay",
    "bench:prune": "pnpm --filter @veil/playground bench:prune"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "turbo": "^2.8.10",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  }
}
